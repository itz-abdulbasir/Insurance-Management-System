# ==============================================================================
# Insurance Management System (IMS) — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and configure your secret credentials before running.
# DO NOT commit the actual '.env' file to your Git repository.
# ==============================================================================

# ── Seeded Administrator Credentials ──────────────────────────────────────────
# Used only on first launch to bootstrap the initial Administrator account.
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@ims.local
ADMIN_PASSWORD=ChangeThisPasswordImmediately!

# ── Role Onboarding Secret Passkeys ───────────────────────────────────────────
# Required by new applicants during registration to request Staff accounts.
ADMIN_PASSKEY=SetAStrongRandomSecretPasskeyForAdmins
AGENT_PASSKEY=SetAStrongRandomSecretPasskeyForAgents

# ── Environment & Logging ─────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
